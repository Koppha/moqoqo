{
  "expo": {
    "name": "EcoCash Super App",
    "slug": "moqoqo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecocashsuper.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-themed.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ecocashsuper.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#5B2C9F",
          "defaultChannel": "default"
        }
      ],
      [
        "./plugins/withNdkVersion",
        {
          "version": "28.2.13676358"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose photos of documents for EcoSure quotes and claims.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of documents for EcoSure quotes and claims.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save your receive money QR code to Photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your wallet."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-ecocash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/splash-ecocash.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoCash Super App uses your location to show the nearest agents, shops and ATMs."
        }
      ]
    ],
    "scheme": "moqoqo",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "econet-telecom-lesotho",
    "extra": {
      "variant": "customer",
      "apiUrl": "http://localhost:4000",
      "router": {},
      "eas": {
        "projectId": "3bfae78e-8a17-4241-93c6-cd61ee149062"
      }
    }
  }
}
