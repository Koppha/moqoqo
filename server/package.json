{
  "name": "moqoqo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Moqoqo chat-and-payments backend (EcoCash, Econet Telecom Lesotho)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:set-login": "tsx src/scripts/set-admin-login.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.9",
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
