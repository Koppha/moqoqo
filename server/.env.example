# Copy to .env (or export in the environment). All values are optional.
# The server reads process.env; `npm run dev` / `npm start` load .env automatically when present.

PORT=4000
HOST=0.0.0.0

# Real PostgreSQL (16+; tested SQL targets Postgres 18). When unset, an embedded PGlite
# database is persisted in DATA_DIR instead (zero setup).
# DATABASE_URL=postgres://moqoqo:secret@localhost:5432/moqoqo
DATA_DIR=./.data

# Comma-separated allowed browser origins. Default: http://localhost:5173 (portal dev) and
# Expo dev servers (http://localhost:8081, http://localhost:19006). Use * to allow any origin.
# CORS_ORIGINS=https://portal.moqoqo.etl.co.ls,http://localhost:5173

# First admin, created on first start when no admin exists. If unset, admin@moqoqo.local is
# created with a random password that is printed ONCE to the console.
# ADMIN_EMAIL=ops@etl.co.ls
# ADMIN_PASSWORD=change-me-please

# Send Expo push notifications for new messages to members with no open WebSocket.
PUSH_ENABLED=false

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Moqoqo Assistant (AI chat in every person's Chats). Claude API key from console.anthropic.com; keep it here on the
# server only, never in the apps. Without it the assistant chat replies that it isn't switched on yet.
# The same key powers AI case summaries in the portal (Cases); without it that button explains it needs the key.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium   # low | medium | high (lower = faster, cheaper answers)

# SMS and email: mock providers for now. Every SMS/email (and push while PUSH_ENABLED=false) is recorded in the
# portal under Notifications instead of being sent. Real providers plug in via src/notify/gateways.ts.

# SIM swap: shared secret Econet sends (header x-webhook-secret) to POST /v1/hooks/sim-swap. Unset = webhook off;
# until Econet is connected, staff simulate swaps in the portal (Users › SIM swap).
# SIM_SWAP_WEBHOOK_SECRET=
# Econet's SIM swap API: the server asks it before risky steps and when the app reports a changed or dead SIM.
# Without these, swaps are simulated in the portal. Path, auth and fields to confirm with Econet (gateways/simswap.ts).
# ECONET_SIMSWAP_URL=
# ECONET_SIMSWAP_KEY=
# ECONET_SIMSWAP_HEADER=Authorization
# ECONET_SIMSWAP_CACHE_SECONDS=300

# EcoSure policy manager package list: funeral prices, cover amounts, waiting periods and beneficiary rules are
# synced from it at start and every ECOSURE_PACKAGES_SYNC_MINUTES. Unset = the catalogue stays as it is in the database.
# ECOSURE_PACKAGES_URL=http://10.3.10.162:15224/ecosure-policy-manager/api/v2/packages?countryCode=LS&category=CUSTOM
# ECOSURE_PACKAGES_SYNC_MINUTES=60

# ---------- security (CBL/LCA DFS guidelines) ----------
# Encryption at rest for documents, photos, card tokens, request details and assistant chats: "kid:base64-32-bytes",
# newest first. Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate: put the new key first ("k2:…,k1:…"), restart, run `npm run rotate-data-key`, then remove the old key.
# In production keep these in the secret store / key vault, never in this file or git.
# DATA_KEYS=
# TLS: either the proxy terminates it (keep REQUIRE_TLS=true so plain http is refused), or the server does:
# REQUIRE_TLS=true
# TLS_CERT_FILE=/etc/ssl/ecocash/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/ecocash/privkey.pem
# Android SMS Retriever app hashes, per app (shown in test builds' server sheet): customer:XXXXXXXXXXX,business:…
# SMS_APP_HASHES=
