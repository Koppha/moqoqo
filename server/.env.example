# Copy to .env (or export in the environment). All values are optional.
# The server reads process.env; `npm run dev` / `npm start` load .env automatically when present.

PORT=4000
HOST=0.0.0.0

# Real PostgreSQL (16+; tested SQL targets Postgres 18). When unset, an embedded PGlite
# database is persisted in DATA_DIR instead (zero setup).
# DATABASE_URL=postgres://moqoqo:secret@localhost:5432/moqoqo
DATA_DIR=./.data

# Comma-separated allowed browser origins. Default: http://localhost:5173 (portal dev) and
# Expo dev servers (http://localhost:8081, http://localhost:19006). Use * to allow any origin.
# CORS_ORIGINS=https://portal.moqoqo.etl.co.ls,http://localhost:5173

# First admin, created on first start when no admin exists. If unset, admin@moqoqo.local is
# created with a random password that is printed ONCE to the console.
# ADMIN_EMAIL=ops@etl.co.ls
# ADMIN_PASSWORD=change-me-please

# Send Expo push notifications for new messages to members with no open WebSocket.
PUSH_ENABLED=false

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Moqoqo Assistant (AI chat in every person's Chats). Claude API key from console.anthropic.com; keep it here on the
# server only, never in the apps. Without it the assistant chat replies that it isn't switched on yet.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium   # low | medium | high (lower = faster, cheaper answers)

# SMS and email: mock providers for now. Every SMS/email (and push while PUSH_ENABLED=false) is recorded in the
# portal under Notifications instead of being sent. Real providers plug in via src/notify/gateways.ts.
